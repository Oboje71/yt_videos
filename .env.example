# YouTube Content Automation Workflow - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# RAPIDAPI - YouTube Transcript Extraction
# ============================================
# Get your key from: https://rapidapi.com
# Subscribe to: YouTube Transcript API
RAPIDAPI_KEY=your_rapidapi_key_here

# ============================================
# VIZARD AI - Video Short Creation
# ============================================
# Get your key from: https://vizard.ai
# May require contacting support for API access
VIZARD_API_KEY=your_vizard_api_key_here

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Email address that will appear as sender
SENDER_EMAIL=your_email@domain.com

# ============================================
# OPTIONAL: Custom Configuration
# ============================================
# Uncomment and modify as needed

# OpenAI Model Selection
# OPENAI_MODEL=gpt-4-turbo-preview

# Google Drive Parent Folder ID (to save all content in specific folder)
# GDRIVE_PARENT_FOLDER_ID=your_folder_id_here

# Custom Webhook Path
# WEBHOOK_PATH=youtube-automation

# Enable Debug Mode
# DEBUG_MODE=true

# ============================================
# CREDENTIALS TO CONFIGURE IN N8N UI
# ============================================
# These cannot be set via environment variables
# Configure them in n8n Settings → Credentials:
#
# 1. OpenAI API
#    - Name: "OpenAI API"
#    - API Key: Your OpenAI key
#
# 2. Google Drive OAuth2 API
#    - Name: "Google Drive OAuth2"
#    - Follow OAuth flow
#
# 3. SMTP Account
#    - Name: "SMTP Account"
#    - Host: smtp.gmail.com (or your provider)
#    - Port: 587
#    - Username: your_email@gmail.com
#    - Password: your_app_password
#    - Secure: Use TLS

# ============================================
# NOTES
# ============================================
# - Never commit the actual .env file to git
# - Keep your API keys secure
# - Rotate keys regularly
# - Use app-specific passwords for email
# - Monitor API usage and costs
