      "id": "webhook-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "webhookId": "youtube-auto"
    },
    {
      "parameters": {
        "jsCode": "const youtubeUrl = $input.item.json.youtube_url;\nlet videoId = '';\n\nif (youtubeUrl.includes('youtu.be/')) {\n  videoId = youtubeUrl.split('youtu.be/')[1].split('?')[0];\n} else if (youtubeUrl.includes('youtube.com/watch?v=')) {\n  videoId = youtubeUrl.split('v=')[1].split('&')[0];\n} else if (youtubeUrl.includes('youtube.com/embed/')) {\n  videoId = youtubeUrl.split('embed/')[1].split('?')[0];\n}\n\nreturn {\n  json: {\n    youtube_url: youtubeUrl,\n    video_id: videoId,\n    client_email: $input.item.json.client_email || '',\n    client_name: $input.item.json.client_name || 'Client'\n  }\n};"
      },
      "id": "code-1",
      "name": "Extract Video ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://youtube-transcript3.p.rapidapi.com/api/transcript",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-RapidAPI-Key",
              "value": "={{ $env.RAPIDAPI_KEY }}"
            },
            {
              "name": "X-RapidAPI-Host",
              "value": "youtube-transcript3.p.rapidapi.com"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "video_id",
              "value": "={{ $json.video_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-1",
      "name": "Get Transcript",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": "gpt-4-turbo-preview",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an expert content strategist. Analyze the YouTube transcript and identify the most engaging hooks. Return JSON format with an array of hooks with timestamp, hook_text, context, and engagement_potential (1-10)."
            },
            {
              "role": "user",
              "content": "=Analyze this transcript and identify top 5-10 hooks:\\n\\n{{ $json.transcript }}"
            }
          ]
        },
        "options": {
          "temperature": 0.7,
          "maxTokens": 2000
        }
      },
      "id": "openai-1",
      "name": "Identify Hooks",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.3,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.item.json.message?.content || $input.item.json.text;\nlet hooks = [];\n\ntry {\n  const jsonMatch = response.match(/\\[.*\\]/s) || response.match(/\\{.*\\}/s);\n  if (jsonMatch) {\n    const parsed = JSON.parse(jsonMatch[0]);\n    hooks = Array.isArray(parsed) ? parsed : [parsed];\n  }\n} catch (e) {\n  hooks = [{ hook_text: response, engagement_potential: 8 }];\n}\n\nconst prevData = $('Extract Video ID').item.json;\nconst transcriptData = $('Get Transcript').item.json;\n\nreturn {\n  json: {\n    youtube_url: prevData.youtube_url,\n    video_id: prevData.video_id,\n    transcript: transcriptData.transcript,\n    hooks: hooks,\n    client_email: prevData.client_email,\n    client_name: prevData.client_name,\n    all_hooks_text: hooks.map(h => h.hook_text).join('\\n\\n')\n  }\n};"
      },
      "id": "code-2",
      "name": "Parse Hooks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": "gpt-4-turbo-preview",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a social media expert for X (Twitter). Create engaging, concise posts under 280 characters with hashtags."
            },
            {
              "role": "user",
              "content": "=Create 3 X posts based on these hooks:\\n\\n{{ $json.all_hooks_text }}\\n\\nFormat as JSON array with post_number and content."
            }
          ]
        },
        "options": {
          "temperature": 0.8,
          "maxTokens": 1000
        }
      },
