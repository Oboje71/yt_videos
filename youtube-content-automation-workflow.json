      "id": "http-2",
      "name": "Create Vizard Shorts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1340,
        540
      ]
    },
    {
      "parameters": {
        "jsCode": "const baseData = $('Parse Hooks').item.json;\nconst xPosts = $('Create X Posts').item.json;\nconst linkedinPosts = $('Create LinkedIn Posts').item.json;\nconst instagramPosts = $('Create Instagram Posts').item.json;\nconst vizardData = $('Create Vizard Shorts').item.json;\n\nfunction extractContent(data) {\n  const text = data.message?.content || data.text || JSON.stringify(data);\n  try {\n    const match = text.match(/\\[.*\\]/s);\n    if (match) return JSON.parse(match[0]);\n  } catch(e) {}\n  return [{ content: text }];\n}\n\nconst xArray = extractContent(xPosts);\nconst linkedinArray = extractContent(linkedinPosts);\nconst instagramArray = extractContent(instagramPosts);\n\nconst xText = xArray.map((p, i) => `POST ${i + 1}:\\n${p.content || p.post}\\n`).join('\\n---\\n\\n');\nconst linkedinText = linkedinArray.map((p, i) => `POST ${i + 1}:\\n${p.content || p.post}\\n`).join('\\n---\\n\\n');\nconst instagramText = instagramArray.map((p, i) => `POST ${i + 1}:\\n${p.caption || p.content}\\n\\nHashtags: ${p.hashtags || ''}\\n`).join('\\n---\\n\\n');\nconst hooksText = baseData.hooks.map((h, i) => `HOOK ${i + 1}:\\n${h.hook_text}\\n`).join('\\n---\\n\\n');\n\nconst timestamp = new Date().toISOString().replace(/[:.]/g, '-').slice(0, -5);\nconst folderName = `YT_Content_${baseData.video_id}_${timestamp}`;\n\nreturn {\n  json: {\n    ...baseData,\n    folder_name: folderName,\n    timestamp: timestamp,\n    x_posts_text: xText,\n    linkedin_posts_text: linkedinText,\n    instagram_posts_text: instagramText,\n    hooks_text: hooksText,\n    vizard_id: vizardData.video_id || vizardData.id || 'processing'\n  }\n};"
      },
