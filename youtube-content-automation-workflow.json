    {
      "parameters": {
        "method": "POST",
        "url": "https://api.vizard.ai/v1/video/create",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.VIZARD_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "video_url",
              "value": "={{ $('Parse Hooks').item.json.youtube_url }}"
            },
            {
              "name": "style",
